{
  "name": "unbaht",
  "version": "0.1.0",
  "description": "Read Thai number words back into exact numbers: หนึ่งพันสองร้อยห้าสิบบาทถ้วน → 1250, สามร้อยยี่สิบเอ็ดบาทห้าสิบสตางค์ → 321.50, 1.5 ล้าน, แสนห้า, ร้อยกว่า (a range, never a made-up exact number). Finds numbers in running text too.",
  "keywords": [
    "thai",
    "number",
    "words",
    "baht",
    "bahttext",
    "parse",
    "ตัวเลข",
    "อ่านตัวเลข",
    "บาท"
  ],
  "license": "MIT",
  "author": "Tanawat Pinthongpan",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.7",
    "eslint": "^10.15.0",
    "fast-check": "^4.11.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.2"
  }
}
